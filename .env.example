# demo: always use explicit demo data; live: call configured providers
APP_DATA_MODE=demo
# When live providers fail, visibly fall back to demo data for supported cities.
ALLOW_DEMO_FALLBACK=true

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

AMAP_API_KEY=
# Web端（JS API）Key。该 Key 会由浏览器加载地图脚本，需在高德控制台限制可用域名。
AMAP_JS_API_KEY=
# Web端（JS API）安全密钥，仅由 Next.js 服务端代理读取，禁止加 NEXT_PUBLIC_ 前缀。
AMAP_JS_SECURITY_CODE=

# Aliyun Marketplace product cmapi00064421
ALIYUN_SCENIC_API_HOST=https://jmqgjdcx.market.alicloudapi.com
ALIYUN_SCENIC_API_PATH=/area/scenic-spots
ALIYUN_SCENIC_API_APPCODE=

# Supabase public browser configuration. Never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
